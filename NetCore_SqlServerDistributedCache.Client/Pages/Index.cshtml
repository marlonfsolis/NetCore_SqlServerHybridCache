@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>
        This is a Razor Pages app That use a custom implementation of Hybrid Cache.
        Here you can see how to cache Application Wide data as well as Session data.
    </p>
</div>

<hr />

<h1>App Cache</h1>

<div class="row my-5">
    <div class="col-6">
        <form method="post" id="SetForm">
            <div class="mb-3">
                <label for="CacheKeyName" class="form-label">Key Name</label>
                <input type="text" class="form-control" id="CacheKeyName" name="CacheKeyName">
                <div class="form-text">This is a unique name.</div>
            </div>
            <div class="mb-3">
                <label for="CacheKeyValue" class="form-label">Key Value</label>
                <input type="text" class="form-control" id="CacheKeyValue" name="CacheKeyValue">
                <div class="form-text">The value that will be saved under the Key Name</div>
            </div>
            <button type="submit" class="btn btn-primary" asp-page-handler="SetCacheItem">Set Value</button>
            <button type="submit" class="btn btn-danger" asp-page-handler="ClearCache">Clear</button>
        </form>
    </div>
    <div class="col-6">
        <h5>Cache Key/Value List</h5>

        <form method="post" id="TableForm">
            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>Key Name</th>
                        <th>Key Vale</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (KeyValuePair<string, string> item in Model.CacheValueList)
                    {
                        <tr>
                            <td>@item.Key</td>
                            <td>@item.Value</td>
                            <td>
                                <button type="submit" class="btn btn-danger"
                                        asp-page-handler="RemoveCacheItem" asp-route-key="@item.Key">
                                    Delete
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </form>
    </div>
</div>

