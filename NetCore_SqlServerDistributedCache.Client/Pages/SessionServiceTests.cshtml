@page
@model NetCore_SqlServerDistributedCache.Client.Pages.SessionServiceTestsModel
@{
    ViewData["Title"] = "Session Tests page";
}

<div class="text-center">
    <h1 class="display-4">Session Service Tests</h1>
    <p>
        This is a Razor Pages app That use a custom implementation of Hybrid Session Cache.
        Here you can see how to cache Session data.
    </p>
</div>

<hr />

<div class="row my-5">
    <div class="col-6">
        <form method="post" id="SetSessionForm">
            <div class="mb-3">
                <label for="SessionKeyName" class="form-label">Key Name</label>
                <input type="text" class="form-control" id="SessionKeyName" name="SessionKeyName">
                <div class="form-text">This is a unique name.</div>
            </div>
            <div class="mb-3">
                <label for="SessionKeyValue" class="form-label">Key Value</label>
                <input type="text" class="form-control" id="SessionKeyValue" name="SessionKeyValue">
                <div class="form-text">The value that will be saved under the Key Name</div>
            </div>
            <button type="submit" class="btn btn-primary" asp-page-handler="SetSessionItem">Set Value</button>
            <button type="submit" class="btn btn-danger" asp-page-handler="ClearSession">Clear</button>
            <button type="submit" class="btn btn-outline-danger" asp-page-handler="DeleteSession">Delete Session</button>
        </form>
    </div>
    <div class="col-6">
        <h5>Session Key/Value List</h5>

        <form method="post" id="TableSessionForm">
            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>Key Name</th>
                        <th>Key Vale</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (KeyValuePair<string, string> item in Model.SessionValueList)
                    {
                        <tr>
                            <td>@item.Key</td>
                            <td>@item.Value</td>
                            <td>
                                <button type="submit" class="btn btn-danger"
                                        asp-page-handler="RemoveSessionItem" asp-route-key="@item.Key">
                                    Delete
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </form>
    </div>
</div>